<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>TravianBotSharp</AssemblyName>
    <SignAssembly>False</SignAssembly>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <PlaywrightPlatform>win</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CP.Extensions.Hosting.ReactiveUI.Wpf" Version="5.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="ReactiveUI.Drawing" Version="24.2.0" />
    <PackageReference Include="ReactiveUI.WPF" Version="24.2.0" />    
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MainCore\MainCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyElectronRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_ElectronDist>$(MSBuildProjectDirectory)\..\web\node_modules\electron\dist</_ElectronDist>
      <_ElectronOut>$(OutputPath)electron\</_ElectronOut>
    </PropertyGroup>
    <ItemGroup>
      <_ElectronFiles Include="$(_ElectronDist)\**\*" Condition="Exists('$(_ElectronDist)\electron.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElectronFiles)" DestinationFiles="@(_ElectronFiles->'$(_ElectronOut)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(_ElectronDist)\electron.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\web\electron\main.cjs" DestinationFiles="$(_ElectronOut)main.cjs" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\..\web\electron\main.cjs')" />
  </Target>

  <Target Name="CopyElectronRuntimeToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_ElectronDist>$(MSBuildProjectDirectory)\..\web\node_modules\electron\dist</_ElectronDist>
      <_ElectronOut>$(PublishDir)electron\</_ElectronOut>
    </PropertyGroup>
    <ItemGroup>
      <_ElectronPublishFiles Include="$(_ElectronDist)\**\*" Condition="Exists('$(_ElectronDist)\electron.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElectronPublishFiles)" DestinationFiles="@(_ElectronPublishFiles->'$(_ElectronOut)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(_ElectronDist)\electron.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\web\electron\main.cjs" DestinationFiles="$(_ElectronOut)main.cjs" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(MSBuildProjectDirectory)\..\web\electron\main.cjs')" />
  </Target>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WPFUI.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  
</Project>
