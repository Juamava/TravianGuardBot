<Window x:Class="Updater.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Travian Guard"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="DragWindow">
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#B5BAC1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3F4147"/>
                                <Setter Property="Foreground" Value="#F2F3F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#ED4245"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="18" Background="Transparent">
        <Border CornerRadius="18" Background="#252628" Padding="28,16,16,28">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <StackPanel Margin="4,10,12,0">
                    <Image Source="pack://application:,,,/logo.png" MaxWidth="440" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    <TextBlock x:Name="VersionText" Foreground="#F2F3F5" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="16" FontFamily="Segoe UI"/>
                    <ProgressBar x:Name="Bar" Height="8" Margin="12,18,12,0" Minimum="0" Maximum="100" BorderThickness="0" Background="#3F4147" Foreground="#5865F2" IsIndeterminate="True"/>
                    <TextBlock x:Name="StatusText" Foreground="#B5BAC1" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13" FontFamily="Segoe UI" TextAlignment="Center" TextWrapping="Wrap" Text="Preparando la actualización..."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="__" Click="MinimizeClick" ToolTip="Minimizar" Style="{StaticResource WindowButton}"/>
                    <Button Content="X" Click="CloseClick" Margin="4,0,0,0" ToolTip="Cancelar" Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
